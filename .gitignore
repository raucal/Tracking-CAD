# Local inputs, generated datasets, model weights, and caches.
/captures/
/archives/maintenance/
/data/prepared*/
/data/assemblies/*/prepared*/
/checkpoints/
/.cache/
/.runtime/

# Version only the two explicitly retained, self-contained evidence bundles.
# All newly generated evaluations and exports remain local by default.
/results/*
!/results/index.html
!/results/dashboard
!/results/reports/
/results/reports/*
!/results/reports/sam6d_suite_20261102T150131Z/
!/results/evaluations/
/results/evaluations/*
!/results/evaluations/sam6d_fp_corner_full_20261111/
/results/evaluations/sam6d_fp_corner_full_20261111/runtime/

# Compiled extensions and local build products; rebuild for the target runtime.
/pipeline/native/
build/
dist/
*.egg-info/
*.so
*.o
*.a
*.dll
*.dylib
*.pyd

# Python environments, bytecode, test and tooling caches.
.venv/
.venvs/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Downloaded model artifacts, including interrupted downloads.
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.download
*.part

# Personal credentials and machine-specific overrides.
.env
.env.*
!.env.example
/config/*.local.json
/config/*.local.json.*

# Local logs; only selected evidence-bundle logs are retained.
*.log
!/results/reports/sam6d_suite_20261102T150131Z/**/*.log
!/results/evaluations/sam6d_fp_corner_full_20261111/**/*.log

# Editor/OS files.
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Protected legacy SDU checkout; the official submodule is used instead.
/models/FoundationPose/

# Temporary presentation backups and test artifacts.
*.before-*.html
*.bak
*.tmp
/test-results.xml
